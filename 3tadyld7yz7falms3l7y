-- دالة إزالة وتدمير الهايلايت
local function removeHighlight()
	if currentHighlight then
		currentHighlight:Destroy()
		currentHighlight = nil
	end
end

-- دالة إنشاء الهايلايت وتفعيله فقط للمجسم النشط
local function applyHighlight(target)
	removeHighlight()
	if target then
		currentHighlight = Instance.new("Highlight")
		currentHighlight.FillColor = Color3.fromRGB(0, 255, 130)
		currentHighlight.OutlineColor = Color3.fromRGB(255, 255, 255)
		currentHighlight.FillTransparency = 0.4
		currentHighlight.Adornee = target
		currentHighlight.Parent = target
	end
end

-- دالة تحريك المجسم
local function moveActiveModel(vector)
	if not activeModel then return end
	
	if activeModel:IsA("Model") then
		activeModel:PivotTo(activeModel:GetPivot() + vector)
	elseif activeModel:IsA("BasePart") then
		activeModel.CFrame = activeModel.CFrame + vector
	end
end

-- دالة تدوير المجسم
local function rotateActiveModel(x, y, z)
	if not activeModel then return end
	local radX, radY, radZ = math.rad(x), math.rad(y), math.rad(z)
	local rotationCFrame = CFrame.Angles(radX, radY, radZ)
	
	if activeModel:IsA("Model") then
		activeModel:PivotTo(activeModel:GetPivot() * rotationCFrame)
	elseif activeModel:IsA("BasePart") then
		activeModel.CFrame = activeModel.CFrame * rotationCFrame
	end
end

