-- 2. منطق العمليات (Logic)

local function resetAll()
	removeHighlight()
	selectedTarget = nil
	activeModel = nil
	isSelecting = false
	
	selectBtn.Text = "1. حدد مجسم"
	selectBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
	copyBtn.Visible = false
	moveFrame.Visible = false
	rotateFrame.Visible = false
	finishBtn.Visible = false
end

-- إظهار وإخفاء الواجهة بحرف P
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == Enum.KeyCode.P then
		mainFrame.Visible = not mainFrame.Visible
	end
end)

-- بدء التحديد
selectBtn.MouseButton1Click:Connect(function()
	resetAll()
	isSelecting = true
	selectBtn.Text = "اضغط على أي مجسم بالماب..."
	selectBtn.BackgroundColor3 = Color3.fromRGB(200, 120, 0)
end)

-- تحديد المجسم بالماوس وتظليله
mouse.Button1Down:Connect(function()
	if not isSelecting then return end
	
	local target = mouse.Target
	if target then
		selectedTarget = target:FindFirstAncestorOfClass("Model") or target
		activeModel = selectedTarget
		
		-- إظهار التوهج فقط أثناء تحديد/تعديل المجسم
		applyHighlight(activeModel)
		
		selectBtn.Text = "تم التحديد: " .. activeModel.Name
		selectBtn.BackgroundColor3 = Color3.fromRGB(0, 120, 215)
		
		copyBtn.Visible = true
		moveFrame.Visible = true
		rotateFrame.Visible = true
		finishBtn.Visible = true
		isSelecting = false
	end
end)

-- عملية النسخ وإخفاء التوهج فوراً
copyBtn.MouseButton1Click:Connect(function()
	if not selectedTarget then return end
	
	-- إزالة الهايلايت حتى لا يُنسخ مع الموديل
	removeHighlight()
	
	local success, cloned = pcall(function()
		return selectedTarget:Clone()
	end)
	
	if success and cloned then
		-- ضمان إزالة أي Highlight داخلي
		for _, child in pairs(cloned:GetDescendants()) do
			if child:IsA("Highlight") then
				child:Destroy()
			end
		end
		if cloned:IsA("Highlight") then
			cloned:Destroy()
		end

		cloned.Parent = workspace
		activeModel = cloned
		
		-- إزاحة النسخة قليلاً لتمييزها
		moveActiveModel(Vector3.new(0, 3, 0))
		
		selectBtn.Text = "تم النسخ! عدل الموقع والاتجاه أدناه"
		copyBtn.BackgroundColor3 = Color3.fromRGB(100, 100, 100)
	end
end)

-- إنهاء وإخفاء الـ Highlight كلياً
finishBtn.MouseButton1Click:Connect(function()
	resetAll()
end)
